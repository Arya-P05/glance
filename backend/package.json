{
  "name": "instagram-sync",
  "version": "1.0.0",
  "description": "Scrape Instagram profile and sync images to Supabase",
  "type": "module",
  "main": "sync.js",
  "scripts": {
    "summer-roll": "node summer-roll/server.js",
    "gen": "node generate.js",
    "gen:prompts": "node generate.js --mode prompts",
    "gen:images": "node generate.js --mode images",
    "publish": "node publish.js",
    "migrate": "node migrate.js",
    "sync": "node sync.js",
    "bulk": "node sync.js --bulk",
    "collect-links": "node collect-links.js",
    "import-links": "node import-from-links.js",
    "render-caption": "node render-caption.js",
    "clear-posts": "node clear-posts-and-storage.js",
    "prune-orphans": "node prune-orphan-posts.js",
    "admin": "node admin-server.js",
    "install-browser": "npx playwright install chromium",
    "assets:cleanup": "node cleanup-images.js",
    "gen:recover": "node recover-backgrounds.js",
    "generation-lab": "node generation-lab/server.js",
    "generation-lab:prepare": "node generation-lab/prepare.js",
    "generation-lab:analyze": "node generation-lab/analyze-bank.js",
    "generation-lab:analyze-human": "node generation-lab/analyze-human-reviews.js",
    "generation-lab:build-validation": "node generation-lab/build-validation.js",
    "generation-lab:build-human-round": "node generation-lab/build-human-round.js",
    "generation-lab:build-emotion-round": "node generation-lab/build-emotion-round.js",
    "generation-lab:build-emotion-validation": "node generation-lab/build-emotion-validation.js",
    "generation-lab:retry-failures": "node generation-lab/retry-failures.js",
    "generation-lab:report-validation": "node generation-lab/report-validation.js",
    "generation-lab:test": "node --test generation-lab/lab.test.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^16.4.5",
    "openai": "^6.10.0",
    "playwright": "^1.49.0",
    "sharp": "^0.33.5"
  }
}
