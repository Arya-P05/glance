# Single Instagram username to scrape
INSTAGRAM_USERNAME=

# Optional (recommended for bulk): Instagram session cookie value (cookie name: sessionid)
# Without this, Instagram may limit logged-out profiles to ~12 posts.
INSTAGRAM_SESSIONID=

# If sessionid alone still caps at ~12 posts, export full instagram.com cookies as JSON and point to it:
INSTAGRAM_COOKIES_PATH=

# Supabase (use service role key so the job can write to Storage and DB)
# Backend scripts accept either name for the URL:
SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Database password for running migrations (npm run migrate)
# Find it at: Supabase Dashboard → Project Settings → Database → Database password
SUPABASE_DB_PASSWORD=

# Motivational poster generator (npm run generate-posters)
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_PROMPT_MODEL=gpt-5-mini
# OPENAI_CAPTION_MODEL=gpt-5-mini
# OPENAI_IMAGE_SIZE=1024x1024
# POSTER_COUNT=25
# POSTER_OUTPUT_DIR=motivational_assets
# POSTER_UPLOAD=false
# POSTER_IMAGE_ONLY=false
# POSTER_PROMPT_ONLY=false

# Limit how many posts to fetch per run (bulk uses this too)
MAX_POSTS=50

# Set to false to watch the browser (debug)
HEADLESS=true

# Local admin UI (npm run admin) — optional auth for /api/*
# ADMIN_TOKEN=
# ADMIN_PORT=3847
# ADMIN_HOST=127.0.0.1
